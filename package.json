{
  "name": "distill-mem-mcp",
  "version": "0.1.0",
  "description": "MCP server that helps lower token cost for agent memory: entities, relations, observations with compression, ranking, decay, and a strict token budget.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "distill-mem-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.2.0",
    "dotenv": "18.0.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "better-sqlite3@13.2.0": true
  }
}
